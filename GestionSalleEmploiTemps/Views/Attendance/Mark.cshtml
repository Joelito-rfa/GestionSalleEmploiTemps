@model EMIT.Application.DTOs.BulkAttendanceDto
@{
    ViewData["Title"] = "Marquer les présences";
    var schedule = ViewBag.Schedule as EMIT.Application.DTOs.ScheduleDto;
    var studentNames = ViewBag.StudentNames as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="page-header"><div><h1 class="fw-bold mb-1"><i class="fa-regular fa-circle-check text-success me-2"></i><span>Marquer les présences</span></h1></div></div>

@if (schedule != null)
{
    <p class="lead">
        <strong>@schedule.Level</strong> - @GetDayFrenchName(schedule.Day) @schedule.StartTime.ToString(@"hh\:mm")-@schedule.EndTime.ToString(@"hh\:mm")
        | Salle: @schedule.RoomName | Enseignant: @schedule.TeacherName
    </p>
}

<hr />

<form asp-action="Mark" method="post">
    <input type="hidden" asp-for="ScheduleId" />
    <input type="hidden" asp-for="Date" />

    <div class="card shadow">
        <div class="card-body">
            <table class="table mb-0">
                <thead><tr><th>Étudiant</th><th>Présent</th><th>Notes</th></tr></thead>
                <tbody>
                    @for (int i = 0; i < Model.Students.Count; i++)
                    {
                        var studentId = Model.Students[i].StudentId;
                        <tr>
                            <td>
                                <input type="hidden" asp-for="@Model.Students[i].StudentId" />
                                @(studentNames.ContainsKey(studentId) ? studentNames[studentId] : "Étudiant inconnu")
                            </td>
                            <td>
                                <div class="form-check">
                                    <input asp-for="@Model.Students[i].IsPresent" class="form-check-input" />
                                </div>
                            </td>
                            <td><input asp-for="@Model.Students[i].Notes" class="form-control form-control-sm" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a asp-action="SelectSchedule" class="btn btn-secondary">Retour</a>
    </div>
</form>

@{
    string GetDayFrenchName(DayOfWeek day) => day switch
    {
        DayOfWeek.Monday => "Lundi", DayOfWeek.Tuesday => "Mardi", DayOfWeek.Wednesday => "Mercredi",
        DayOfWeek.Thursday => "Jeudi", DayOfWeek.Friday => "Vendredi", DayOfWeek.Saturday => "Samedi",
        DayOfWeek.Sunday => "Dimanche", _ => day.ToString()
    };
}
