@model IEnumerable<EMIT.Application.DTOs.AttendanceDto>
@{
    ViewData["Title"] = "Présences";
    var schedule = ViewBag.Schedule as EMIT.Application.DTOs.ScheduleDto;
    var levels = ViewBag.Levels as List<SelectListItem> ?? new List<SelectListItem>();
    var selectedLevel = ViewBag.SelectedLevel as EMIT.Domain.Enums.StudentLevel?;
    var presents = Model.Where(m => m.IsPresent).OrderBy(m => m.StudentName).ToList();
    var absents = Model.Where(m => !m.IsPresent).OrderBy(m => m.StudentName).ToList();
    var notMarked = Model.Where(m => m.IsNotMarked).OrderBy(m => m.StudentName).ToList();
}

<div class="page-header">
    <div>
        <h1 class="fw-bold mb-1"><i class="bi bi-check-circle text-success me-2"></i><span data-i18n="attendance.title">Présences</span></h1>
    </div>
    <div class="page-actions d-flex align-items-center gap-3">
        @if (schedule == null)
        {
            <form method="get" class="d-flex align-items-center gap-2">
                <label class="form-label mb-0 fw-medium text-muted small">Filtrer par niveau :</label>
                <select name="level" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                    <option value="">Tous les niveaux</option>
                    @foreach (var item in levels)
                    {
                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                    }
                </select>
            </form>
        }
        <a asp-action="SelectSchedule" class="btn btn-sm btn-success"><i class="bi bi-plus-circle me-1"></i>Marquer présences</a>
    </div>
</div>

@if (schedule != null)
{
    <p class="lead">
        <strong>@schedule.Level</strong> - @GetDayFrenchName(schedule.Day) @schedule.StartTime.ToString(@"hh\:mm")-@schedule.EndTime.ToString(@"hh\:mm")
        | Salle: @schedule.RoomName | Enseignant: @schedule.TeacherName
    </p>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Any())
{
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-success bg-opacity-10">
                <div class="card-body text-center py-3">
                    <h3 class="fw-bold text-success mb-0">@presents.Count</h3>
                    <small class="text-muted">Présent(s)</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-danger bg-opacity-10">
                <div class="card-body text-center py-3">
                    <h3 class="fw-bold text-danger mb-0">@absents.Count</h3>
                    <small class="text-muted">Absent(s)</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-secondary bg-opacity-10">
                <div class="card-body text-center py-3">
                    <h3 class="fw-bold text-secondary mb-0">@notMarked.Count</h3>
                    <small class="text-muted">Non marqué(s)</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-3">
                    <h3 class="fw-bold text-primary mb-0">@Model.Count()</h3>
                    <small class="text-muted">Total</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <i class="bi bi-check-circle me-2"></i><strong>Présents (@presents.Count)</strong>
                </div>
                <div class="card-body p-0">
                    @if (presents.Any())
                    {
                        <div class="input-group m-3">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" id="searchPresent" class="form-control border-start-0 ps-0" placeholder="Rechercher..." />
                        </div>
                        <table class="table table-sm mb-0" id="tablePresent">
                            <tbody>
                                @foreach (var item in presents)
                                {
                                    <tr>
                                        <td class="ps-3"><i class="bi bi-check-circle-fill text-success me-2"></i>@item.StudentName</td>
                                        <td class="text-end pe-3 text-muted"><small>@item.Date.ToLocalTime().ToString("HH:mm")</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3 mb-0">Aucun étudiant présent</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-danger text-white">
                    <i class="bi bi-x-circle me-2"></i><strong>Absents (@absents.Count + @notMarked.Count non marqué(s))</strong>
                </div>
                <div class="card-body p-0">
                    @{
                        var allAbsents = absents.Concat(notMarked).OrderBy(m => m.StudentName).ToList();
                    }
                    @if (allAbsents.Any())
                    {
                        <div class="input-group m-3">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" id="searchAbsent" class="form-control border-start-0 ps-0" placeholder="Rechercher..." />
                        </div>
                        <table class="table table-sm mb-0" id="tableAbsent">
                            <tbody>
                                @foreach (var item in allAbsents)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            @if (item.IsNotMarked)
                                            {
                                                <i class="bi bi-dash-circle-fill text-secondary me-2"></i>
                                                <span class="text-muted">@item.StudentName</span>
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary ms-2" style="font-size:0.65rem;">Non marqué</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-x-circle-fill text-danger me-2"></i>@item.StudentName
                                            }
                                        </td>
                                        <td class="text-end pe-3 text-muted"><small>@item.Date.ToLocalTime().ToString("HH:mm")</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3 mb-0">Tous les étudiants sont présents</p>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-4">
            <i class="bi bi-inbox text-muted" style="font-size: 2rem;"></i>
            <p class="text-muted mb-0 mt-2" data-i18n="attendance.noRecords">Aucune présence enregistrée pour cette séance.</p>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-action="SelectSchedule" class="btn btn-secondary" data-i18n="common.back">Retour</a>
</div>

@section Scripts {
<script>
(function() {
    function setupSearch(inputId, tableId) {
        var input = document.getElementById(inputId);
        if (!input) return;
        input.addEventListener('input', function() {
            var query = this.value.toLowerCase();
            var rows = document.querySelectorAll('#' + tableId + ' tbody tr');
            rows.forEach(function(row) {
                row.style.display = row.textContent.toLowerCase().indexOf(query) !== -1 ? '' : 'none';
            });
        });
    }
    setupSearch('searchPresent', 'tablePresent');
    setupSearch('searchAbsent', 'tableAbsent');
})();
</script>
}

@{
    string GetDayFrenchName(DayOfWeek day) => day switch
    {
        DayOfWeek.Monday => "Lundi", DayOfWeek.Tuesday => "Mardi", DayOfWeek.Wednesday => "Mercredi",
        DayOfWeek.Thursday => "Jeudi", DayOfWeek.Friday => "Vendredi", DayOfWeek.Saturday => "Samedi",
        DayOfWeek.Sunday => "Dimanche", _ => day.ToString()
    };
}
