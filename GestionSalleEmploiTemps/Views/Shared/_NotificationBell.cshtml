@using EMIT.Infrastructure.Data
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
}

@if (currentUser != null)
{
    <div class="dropdown" id="notificationDropdown">
        <button class="btn notification-bell-btn" data-bs-toggle="dropdown" id="notificationBell" data-tooltip="Notifications">
            <i class="fa-regular fa-bell"></i>
            <span id="notificationBadge" class="notification-badge d-none">0</span>
        </button>
        <div class="dropdown-menu dropdown-menu-end notification-dropdown">
            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom" style="border-color: var(--color-border) !important;">
                <h6 class="mb-0 fw-bold small" style="color: var(--color-text);">Notifications</h6>
                <a asp-controller="Notifications" asp-action="Index" class="text-decoration-none small fw-medium" style="color: var(--color-primary);">Tout voir</a>
            </div>
            <div id="notificationList" class="list-group list-group-flush">
                <div class="text-center py-3 small" style="color: var(--color-text-secondary);">
                    <i class="fa-solid fa-spinner fa-spin"></i> Chargement...
                </div>
            </div>
        </div>
    </div>
}

<script>
(function() {
    var badge = document.getElementById('notificationBadge');
    var list = document.getElementById('notificationList');
    if (!badge || !list) return;

    function getTypeIcon(type) {
        var colors = {
            'ScheduleCreated': { bg: 'linear-gradient(135deg, #10B981, #34D399)', icon: 'fa-solid fa-plus' },
            'ScheduleUpdated': { bg: 'linear-gradient(135deg, #F59E0B, #FBBF24)', icon: 'fa-solid fa-pen' },
            'ScheduleDeleted': { bg: 'linear-gradient(135deg, #EF4444, #F87171)', icon: 'fa-solid fa-trash' }
        };
        var c = colors[type] || { bg: 'linear-gradient(135deg, #3B82F6, #6366F1)', icon: 'fa-solid fa-info' };
        return '<div class="d-flex align-items-center justify-content-center flex-shrink-0" style="width:36px;height:36px;border-radius:12px;background:' + c.bg + ';color:#fff;font-size:0.75rem;box-shadow:0 2px 8px rgba(0,0,0,0.15);"><i class="' + c.icon + '"></i></div>';
    }

    function timeAgo(dateStr) {
        var diff = (Date.now() - new Date(dateStr).getTime()) / 1000;
        if (diff < 60) return "A l'instant";
        if (diff < 3600) return "Il y a " + Math.floor(diff/60) + " min";
        if (diff < 86400) return "Il y a " + Math.floor(diff/3600) + "h";
        var d = new Date(dateStr);
        return d.toLocaleDateString('fr-FR') + ' ' + d.toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'});
    }

    function loadNotifications() {
        fetch('/Notifications/GetUnreadCount')
            .then(function(r) { return r.json(); })
            .then(function(count) {
                if (count > 0) { badge.textContent = count; badge.classList.remove('d-none'); }
                else { badge.classList.add('d-none'); }
            })
            .catch(function() {});

        fetch('/Notifications/GetRecent')
            .then(function(r) { return r.json(); })
            .then(function(items) {
                if (!items || items.length === 0) {
                    list.innerHTML = '<div class="text-center py-4" style="color:var(--color-text-secondary);"><i class="fa-regular fa-bell-slash" style="font-size:1.5rem;opacity:0.4;"></i><br><span class="small">Aucune notification</span></div>';
                    return;
                }
                list.innerHTML = '';
                items.forEach(function(n) {
                    var a = document.createElement('div');
                    a.className = 'list-group-item list-group-item-action';
                    a.style.cssText = 'cursor:pointer;border-left:none;border-right:none;border-color:rgba(229,231,235,0.5);padding:12px 16px;' + (n.isRead ? '' : 'background:rgba(59,130,246,0.03);');
                    a.innerHTML = '<div class="d-flex gap-3 align-items-start">' + getTypeIcon(n.type) +
                        '<div class="flex-grow-1">' +
                        '<div class="d-flex justify-content-between align-items-start"><span class="fw-semibold small" style="font-size:0.82rem;color:var(--color-text);' + (n.isRead ? '' : 'color:var(--color-primary);') + '">' + n.title + '</span>' +
                        (n.isRead ? '' : '<span class="badge bg-primary rounded-pill" style="font-size:0.55rem;">Nouveau</span>') +
                        '</div>' +
                        '<p class="mb-1 small" style="font-size:0.78rem;color:var(--color-text-secondary);">' + n.message + '</p>' +
                        '<small style="font-size:0.7rem;color:var(--color-text-secondary);"><i class="fa-regular fa-clock me-1"></i>' + timeAgo(n.createdAt) +
                        (n.targetLevel ? ' <span class="badge" style="font-size:0.55rem;background:var(--color-bg);color:var(--color-text-secondary);">' + n.targetLevel + '</span>' : '') +
                        '</small></div></div>';
                    a.addEventListener('click', function() {
                        window.location.href = '/Notifications/Index';
                    });
                    list.appendChild(a);
                });
                var more = document.createElement('a');
                more.className = 'list-group-item list-group-item-action text-center small fw-bold';
                more.href = '/Notifications/Index';
                more.style.cssText = 'color:var(--color-primary);border-left:none;border-right:none;';
                more.textContent = 'Voir toutes les notifications';
                list.appendChild(more);
            })
            .catch(function() {
                list.innerHTML = '<div class="text-center py-3 small" style="color:var(--color-text-secondary);">Erreur de chargement</div>';
            });
    }

    loadNotifications();
    setInterval(loadNotifications, 60000);
    document.getElementById('notificationBell').addEventListener('shown.bs.dropdown', loadNotifications);
})();
</script>
