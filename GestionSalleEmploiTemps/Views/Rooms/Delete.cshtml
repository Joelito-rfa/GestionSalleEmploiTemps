@model EMIT.Application.DTOs.RoomDto
@{ ViewData["Title"] = "Supprimer salle"; }
<h1>Supprimer salle</h1>
<h3>Êtes-vous sûr ?</h3>
<hr />
<dl class="row">
    <dt class="col-sm-2">Nom</dt><dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">Capacité</dt><dd class="col-sm-10">@Model.Capacity</dd>
    <dt class="col-sm-2">Emplacement</dt><dd class="col-sm-10">@Model.Location</dd>
</dl>
<form asp-action="Delete"><input type="hidden" asp-for="Id" /><input type="submit" value="Supprimer" class="btn btn-danger" /> <a asp-action="Index" class="btn btn-secondary">Retour</a></form>
