@model EMIT.Application.DTOs.TeacherDto
@{ ViewData["Title"] = "Détails enseignant"; }
<h1>Détails enseignant</h1>
<hr />
<dl class="row">
    <dt class="col-sm-2">Nom complet</dt><dd class="col-sm-10">@Model.FullName</dd>
    <dt class="col-sm-2">Email</dt><dd class="col-sm-10">@Model.Email</dd>
    <dt class="col-sm-2">Matière</dt><dd class="col-sm-10">@Model.Subject</dd>
</dl>
<a asp-action="Timetable" asp-route-id="@Model.Id" class="btn btn-info"><i class="fa-regular fa-calendar me-1"></i>Emploi du temps</a>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Modifier</a>
<a asp-action="Index" class="btn btn-secondary">Retour</a>
