@{ Layout = "_LayoutLogin"; ViewData["Title"] = "Accès refusé"; }

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-5 text-center">
                <i class="fa-solid fa-shield-halved text-danger" style="font-size: 3rem;"></i>
                <h2 class="fw-bold mt-3">Accès refusé</h2>
                <p class="text-muted">Vous n'avez pas les permissions nécessaires pour accéder à cette page.</p>
                <a asp-action="Timetable" asp-controller="Home" class="btn btn-primary"><i class="fa-solid fa-house me-1"></i> Retour à l'accueil</a>
            </div>
        </div>
    </div>
</div>
