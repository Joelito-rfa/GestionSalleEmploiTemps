@model EMIT.Application.DTOs.AdminResetPasswordDto
@{
    ViewData["Title"] = "Réinitialiser le mot de passe";
    var fullName = ViewBag.UserFullName as string;
    var email = ViewBag.UserEmail as string;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow border-0">
            <div class="card-body p-5">
                <h3 class="fw-bold mb-4"><i class="bi bi-key me-2"></i>Réinitialiser le mot de passe</h3>

                <div class="alert alert-info">
                    <i class="bi bi-person-circle me-1"></i> <strong>@fullName</strong> — @email
                </div>

                <form asp-action="ResetPassword" method="post">
                    <input type="hidden" asp-for="UserId" />

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-medium"></label>
                        <input asp-for="NewPassword" class="form-control" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmNewPassword" class="form-label fw-medium"></label>
                        <input asp-for="ConfirmNewPassword" class="form-control" />
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning px-4">
                            <i class="bi bi-check-lg me-1"></i> Réinitialiser
                        </button>
                        <a asp-action="Users" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-x-lg me-1"></i> Annuler
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }