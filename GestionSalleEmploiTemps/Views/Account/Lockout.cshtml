@{ Layout = "_LayoutLogin"; ViewData["Title"] = "Compte verrouillé"; }

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow border-0">
            <div class="card-body p-5 text-center">
                <div class="display-1 text-warning mb-3">
                    <i class="bi bi-lock-fill"></i>
                </div>
                <h2 class="fw-bold mb-3">Compte verrouillé</h2>
                <p class="text-muted mb-4">
                    Trop de tentatives de connexion échouées. Votre compte est temporairement verrouillé.
                    Veuillez réessayer dans quelques minutes.
                </p>
                <a asp-action="Login" class="btn btn-primary px-4">Retour à la connexion</a>
            </div>
        </div>
    </div>
</div>
