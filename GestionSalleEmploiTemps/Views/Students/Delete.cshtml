@model EMIT.Application.DTOs.StudentDto
@{ ViewData["Title"] = "Supprimer étudiant"; }
<h1>Supprimer étudiant</h1>
<h3>Êtes-vous sûr ?</h3>
<hr />
<dl class="row">
    <dt class="col-sm-2">Nom</dt><dd class="col-sm-10">@Model.FullName</dd>
    <dt class="col-sm-2">Email</dt><dd class="col-sm-10">@Model.Email</dd>
    <dt class="col-sm-2">Niveau</dt><dd class="col-sm-10">@Model.Level</dd>
</dl>
<form asp-action="Delete"><input type="hidden" asp-for="Id" /><input type="submit" value="Supprimer" class="btn btn-danger" /> <a asp-action="Index" class="btn btn-secondary">Retour</a></form>
