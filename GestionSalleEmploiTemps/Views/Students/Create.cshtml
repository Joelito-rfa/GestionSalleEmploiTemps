@model EMIT.Application.DTOs.CreateStudentDto
@{ ViewData["Title"] = "Nouvel étudiant"; }
<h1>Nouvel étudiant</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" type="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Level" class="form-label"></label><select asp-for="Level" asp-items="ViewBag.Levels" class="form-select"></select><span asp-validation-for="Level" class="text-danger"></span></div>
            <div class="mb-3"><input type="submit" value="Créer" class="btn btn-primary" /> <a asp-action="Index" class="btn btn-secondary">Retour</a></div>
        </form>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
