@model EMIT.Application.DTOs.DashboardDto
@{ ViewData["Title"] = "Tableau de bord"; }

<div class="page-header">
    <div>
        <h1 class="fw-bold mb-1"><i class="bi bi-speedometer2 text-primary me-2"></i><span data-i18n="dashboard.title">Tableau de bord</span></h1>
        <p class="text-muted mb-0 small page-subtitle" data-i18n="dashboard.subtitle">Vue d'ensemble du systeme de gestion</p>
    </div>
    <div class="page-actions">
        <span class="text-muted small"><i class="bi bi-clock me-1"></i>@DateTime.Now.ToString("dddd dd MMMM yyyy")</span>
    </div>
</div>

<!-- Stats Cards -->
<div class="row g-4 mb-4 stagger-container">
    <div class="col-md-3 stagger-item" style="animation: fadeInUp 0.5s ease both;">
        <div class="card border-0 shadow-sm stat-card stat-card-primary hover-lift">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted small mb-1 fw-medium" data-i18n="dashboard.students">Etudiants</p>
                        <h2 class="fw-bold mb-0 stat-number" data-count="@Model.TotalStudents">@Model.TotalStudents</h2>
                    </div>
                    <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <div class="progress" style="height: 4px;">
                        <div class="progress-bar bg-primary" style="width: 100%"></div>
                    </div>
                    <small class="text-muted mt-1 d-block">@Model.TotalStudents inscrits cette annee</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 stagger-item" style="animation: fadeInUp 0.5s ease both; animation-delay: 0.1s;">
        <div class="card border-0 shadow-sm stat-card stat-card-success hover-lift">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted small mb-1 fw-medium" data-i18n="dashboard.teachers">Enseignants</p>
                        <h2 class="fw-bold mb-0 stat-number" data-count="@Model.TotalTeachers">@Model.TotalTeachers</h2>
                    </div>
                    <div class="stat-icon bg-success bg-opacity-10 text-success">
                        <i class="bi bi-person-badge-fill"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <div class="progress" style="height: 4px;">
                        <div class="progress-bar bg-success" style="width: 100%"></div>
                    </div>
                    <small class="text-muted mt-1 d-block">@Model.TotalTeachers corps enseignant</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 stagger-item" style="animation: fadeInUp 0.5s ease both; animation-delay: 0.2s;">
        <div class="card border-0 shadow-sm stat-card stat-card-info hover-lift">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted small mb-1 fw-medium" data-i18n="dashboard.rooms">Salles</p>
                        <h2 class="fw-bold mb-0 stat-number" data-count="@Model.TotalRooms">@Model.TotalRooms</h2>
                    </div>
                    <div class="stat-icon bg-info bg-opacity-10 text-info">
                        <i class="bi bi-door-open-fill"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <div class="progress" style="height: 4px;">
                        <div class="progress-bar bg-info" style="width: @Model.RoomUtilizationPercent%"></div>
                    </div>
                    <small class="text-muted mt-1 d-block">@Model.RoomUtilizationPercent% utilisees</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 stagger-item" style="animation: fadeInUp 0.5s ease both; animation-delay: 0.3s;">
        <div class="card border-0 shadow-sm stat-card stat-card-warning hover-lift">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted small mb-1 fw-medium" data-i18n="dashboard.todaySchedules">Seances aujourd'hui</p>
                        <h2 class="fw-bold mb-0 stat-number" data-count="@Model.TotalSchedulesToday">@Model.TotalSchedulesToday</h2>
                    </div>
                    <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-calendar-check-fill"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <div class="progress" style="height: 4px;">
                        <div class="progress-bar bg-warning" style="width: @Model.AttendanceRate%"></div>
                    </div>
                    <small class="text-muted mt-1 d-block">@Model.AttendanceRate% presences</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Secondary Stats -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm hover-lift" style="animation: fadeInUp 0.5s ease both; animation-delay: 0.15s;">
            <div class="card-body text-center py-3">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10 mb-2" style="width:48px;height:48px;">
                    <i class="bi bi-calendar-week text-primary fs-4"></i>
                </div>
                <h4 class="fw-bold mb-0" data-count="@Model.TotalSchedules">@Model.TotalSchedules</h4>
                <small class="text-muted" data-i18n="dashboard.totalSchedules">Total seances</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm hover-lift" style="animation: fadeInUp 0.5s ease both; animation-delay: 0.2s;">
            <div class="card-body text-center py-3">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success bg-opacity-10 mb-2" style="width:48px;height:48px;">
                    <i class="bi bi-check-circle-fill text-success fs-4"></i>
                </div>
                <h4 class="fw-bold mb-0" data-count="@Model.TotalAttendancesToday">@Model.TotalAttendancesToday</h4>
                <small class="text-muted" data-i18n="dashboard.todayAttendance">Presences aujourd'hui</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm hover-lift" style="animation: fadeInUp 0.5s ease both; animation-delay: 0.25s;">
            <div class="card-body text-center py-3">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-info bg-opacity-10 mb-2" style="width:48px;height:48px;">
                    <i class="bi bi-calendar-check text-info fs-4"></i>
                </div>
                <h4 class="fw-bold mb-0" data-count="@Model.TotalAttendancesWeek">@Model.TotalAttendancesWeek</h4>
                <small class="text-muted" data-i18n="dashboard.weekAttendance">Presences cette semaine</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm hover-lift" style="animation: fadeInUp 0.5s ease both; animation-delay: 0.3s;">
            <div class="card-body text-center py-3">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning bg-opacity-10 mb-2" style="width:48px;height:48px;">
                    <i class="bi bi-graph-up text-warning fs-4"></i>
                </div>
                <h4 class="fw-bold mb-0">@Model.AttendanceRate%</h4>
                <small class="text-muted" data-i18n="dashboard.attendanceRate">Taux de presence</small>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-4 mb-4">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm" style="animation: fadeInUp 0.5s ease both; animation-delay: 0.2s;">
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-bar-chart me-2 text-primary"></i><span data-i18n="dashboard.schedulesByDay">Seances par jour</span></h5>
                    <span class="badge bg-light text-muted"> Hebdomadaire</span>
                </div>
            </div>
            <div class="card-body">
                <canvas id="schedulesByDayChart" height="280"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm" style="animation: fadeInUp 0.5s ease both; animation-delay: 0.3s;">
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-pie-chart me-2 text-success"></i><span data-i18n="dashboard.studentsByLevel">Etudiants</span></h5>
                    <span class="badge bg-light text-muted">Par niveau</span>
                </div>
            </div>
            <div class="card-body">
                <canvas id="studentsByLevelChart" height="280"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Today's Schedules + Recent Activity -->
<div class="row g-4">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm" style="animation: fadeInUp 0.5s ease both; animation-delay: 0.25s;">
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-calendar-day me-2 text-warning"></i>Seances du jour</h5>
                    <a asp-controller="Schedules" asp-action="Index" class="btn btn-sm btn-outline-primary"><span data-i18n="dashboard.seeAll">Voir tout</span></a>
                </div>
            </div>
            <div class="card-body p-0">
                @if (Model.TodaySchedules.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-3">Horaire</th>
                                    <th>Niveau</th>
                                    <th>Salle</th>
                                    <th>Enseignant</th>
                                    <th>Matiere</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.TodaySchedules)
                                {
                                    var levelBadge = s.Level.ToString() switch
                                    {
                                        "L1" => "badge-l1",
                                        "L2" => "badge-l2",
                                        "L3" => "badge-l3",
                                        "M1" => "badge-m1",
                                        "M2" => "badge-m2",
                                        _ => "bg-secondary"
                                    };
                                    <tr>
                                        <td class="ps-3">
                                            <span class="time-badge-sm"><i class="fa-regular fa-clock" style="font-size:0.7rem;"></i> @s.StartTime.ToString(@"hh\:mm") - @s.EndTime.ToString(@"hh\:mm")</span>
                                        </td>
                                        <td><span class="badge @levelBadge">@s.Level</span></td>
                                        <td><i class="bi bi-door-open text-muted me-1"></i>@s.RoomName</td>
                                        <td>@s.TeacherName</td>
                                        <td><span class="subject-tag-sm">@s.Subject</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-calendar-x text-muted"></i>
                        <p class="text-muted mb-0" data-i18n="dashboard.noSchedulesToday">Aucune seance prevue aujourd'hui.</p>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm" style="animation: fadeInUp 0.5s ease both; animation-delay: 0.3s;">
            <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-activity me-2 text-info"></i><span data-i18n="dashboard.recentActivity">Activite recente</span></h5>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentActivity.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var activity in Model.RecentActivity)
                        {
                            var iconClass = activity.Type switch
                            {
                                "schedule" => "bi-calendar-plus text-primary",
                                "student" => "bi-person-plus text-success",
                                _ => "bi-info-circle text-muted"
                            };
                            <div class="list-group-item border-0 py-3 px-3">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center flex-shrink-0" style="width:36px;height:36px;">
                                        <i class="bi @iconClass"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <p class="mb-1 small fw-medium">@activity.Description</p>
                                        <small class="text-muted"><i class="bi bi-clock me-1"></i>@activity.Date.ToString("dd/MM/yyyy HH:mm")</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state py-4">
                        <i class="bi bi-clock-history text-muted" style="font-size: 2rem;"></i>
                        <p class="text-muted small mt-2 mb-0" data-i18n="dashboard.noActivity">Aucune activite recente.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    var dayLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SchedulesByDay.Keys.Select(k => k switch {
        "Monday" => "Lundi", "Tuesday" => "Mardi", "Wednesday" => "Mercredi",
        "Thursday" => "Jeudi", "Friday" => "Vendredi", "Saturday" => "Samedi",
        "Sunday" => "Dimanche", _ => k
    })));
    var dayData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SchedulesByDay.Values));

    var levelLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StudentsByLevel.Keys));
    var levelData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StudentsByLevel.Values));

    var ctxDay = document.getElementById('schedulesByDayChart');
    if (ctxDay) {
        new Chart(ctxDay, {
            type: 'bar',
            data: {
                labels: dayLabels,
                datasets: [{
                    label: 'Seances',
                    data: dayData,
                    backgroundColor: [
                        'rgba(79, 123, 255, 0.8)',
                        'rgba(16, 185, 129, 0.8)',
                        'rgba(245, 158, 11, 0.8)',
                        'rgba(239, 68, 68, 0.8)',
                        'rgba(108, 99, 255, 0.8)',
                        'rgba(6, 182, 212, 0.8)',
                        'rgba(236, 72, 153, 0.8)'
                    ],
                    borderRadius: 10,
                    borderSkipped: false,
                    barThickness: 32
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1, font: { size: 12, family: 'Inter' } },
                        grid: { color: 'rgba(0,0,0,0.04)' }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { font: { size: 12, weight: 500, family: 'Inter' } }
                    }
                }
            }
        });
    }

    var ctxLevel = document.getElementById('studentsByLevelChart');
    if (ctxLevel) {
        new Chart(ctxLevel, {
            type: 'doughnut',
            data: {
                labels: levelLabels,
                datasets: [{
                    data: levelData,
                    backgroundColor: [
                        'rgba(79, 123, 255, 0.85)',
                        'rgba(16, 185, 129, 0.85)',
                        'rgba(108, 99, 255, 0.85)',
                        'rgba(245, 158, 11, 0.85)',
                        'rgba(239, 68, 68, 0.85)'
                    ],
                    borderWidth: 0,
                    hoverOffset: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '65%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { padding: 16, usePointStyle: true, pointStyleWidth: 10, font: { size: 12, family: 'Inter' } }
                    }
                }
            }
        });
    }
});
</script>
}
